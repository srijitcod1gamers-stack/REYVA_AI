{
  "name": "weather-intelligence-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc -b",
    "format": "prettier --write src shared cloudflare/src tests scripts playwright.config.ts vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src shared cloudflare/src tests scripts playwright.config.ts vite.config.ts vitest.config.ts",
    "worker:typecheck": "tsc -p cloudflare/tsconfig.json --noEmit",
    "geo:prepare": "node scripts/prepare-geography.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:dev": "node node_modules/wrangler/wrangler-dist/cli.js dev --config cloudflare/wrangler.toml",
    "worker:deploy": "node node_modules/wrangler/wrangler-dist/cli.js deploy --config cloudflare/wrangler.toml",
    "pages:deploy": "npm run build && node node_modules/wrangler/wrangler-dist/cli.js pages deploy dist --project-name weather-intelligence-ai",
    "db:migrate:local": "node node_modules/wrangler/wrangler-dist/cli.js d1 migrations apply weather-intelligence --local --config cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "wrangler": "^4.35.0"
  }
}
