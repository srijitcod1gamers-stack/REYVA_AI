# demo works offline; api connects to the Worker or FastAPI with the same contract.
VITE_DATA_PROVIDER=demo
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Optional token-free contextual basemap. Local geography always loads first.
VITE_BASEMAP_TILES=https://basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png
# Optional terrain DEM for the 3D terrain control.
VITE_TERRAIN_TILES=https://tiles.mapterhorn.com/tilejson.json
