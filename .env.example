# Use api when running the TypeScript Worker gateway; use demo for offline fixtures.
VITE_DATA_PROVIDER=api
VITE_API_BASE_URL=http://127.0.0.1:8787/api
VITE_MAPTILER_KEY=
# Optional custom tile URL overrides MapTiler. Local geography always loads first.
# VITE_BASEMAP_TILES=https://basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png
# Optional terrain DEM for the 3D terrain control.
VITE_TERRAIN_TILES=https://tiles.mapterhorn.com/tilejson.json
